// createParams projects spec.forProvider onto the create request.
//
// Every field of a twilio-go params struct is a pointer and every one has a
// setter, so an unset optional field is simply never set -- which matters
// because Twilio reads an empty string as an instruction to CLEAR a field
// rather than as "no opinion".
func createParams(cr *{{crdVersion}}.{{kind}}) *twiliogo.{{nickname}}Params {
	params := &twiliogo.{{nickname}}Params{}

{{#createFields}}
{{#required}}
	params.Set{{goName}}({{{setExpr}}})
{{/required}}
{{^required}}
	if {{providerName}}.Set(cr.Spec.ForProvider.{{goName}}) {
		params.Set{{goName}}({{{setExpr}}})
	}
{{/required}}
{{/createFields}}

	return params
}
{{/CREATE}}

{{#UPDATE}}
// updateParams projects spec.forProvider onto the update request. The update
// takes its own parameter set, which is not always the create's -- see
// x-update-after-create in the generator.
func updateParams(cr *{{crdVersion}}.{{kind}}) *twiliogo.{{nickname}}Params {
	params := &twiliogo.{{nickname}}Params{}

{{#updateFields}}
	if {{providerName}}.Set(cr.Spec.ForProvider.{{goName}}) {
		params.Set{{goName}}({{{setExpr}}})
	}
{{/updateFields}}

	return params
}
{{/UPDATE}}

// upToDate compares only the fields the API answers under the same name and
// the same shape. Twilio TAKES `FriendlyName` and ANSWERS `friendly_name`, so
// the pairing is done by the generator through the same snake_case function
// that produced the response names -- compared by Go field name, nothing would
// pair and this would return true for every resource, for ever.
//
// A field the API does not echo back -- a status callback URL, a password, a
// digit string it acts on rather than stores -- cannot be diffed without
// reporting drift on every reconcile, so it is left alone.
func upToDate(cr *{{crdVersion}}.{{kind}}, observed *{{crdVersion}}.{{kind}}Observation) bool {
{{#specFields}}
{{#comparable}}
{{#observedGoName}}
	// Only what the person actually set: an optional field left empty is not a
	// difference from whatever the API chose to put there.
	if {{providerName}}.Set(cr.Spec.ForProvider.{{goName}}) && cr.Spec.ForProvider.{{goName}} != observed.{{observedGoName}} {
		return false
	}
{{/observedGoName}}
{{/comparable}}
{{/specFields}}

	return true
}

func (c *external) Observe(ctx context.Context, cr *{{crdVersion}}.{{kind}}) (managed.ExternalObservation, error) {
	id := meta.GetExternalName(cr)
	if id == "" {
		// Nothing has been created yet.
		return managed.ExternalObservation{ResourceExists: false}, nil
	}

{{#FETCH}}
	r, err := c.service.Rest.{{domainName}}{{apiVersionClass}}.{{nickname}}({{#vendorExtensions.x-cp-args}}{{{expr}}}, {{/vendorExtensions.x-cp-args}}&twiliogo.{{nickname}}Params{})
	if err != nil {
		// ONLY a 404 means it is gone. Any other failure (500, timeout,
		// throttling) must be surfaced -- treating it as "does not exist"
		// would provision a second one and orphan the first.
		if {{providerName}}.IsNotFound(err) {
			return managed.ExternalObservation{ResourceExists: false}, nil
		}
		return managed.ExternalObservation{}, errors.Wrap(err, errGet)
	}

	at := {{crdVersion}}.{{kind}}Observation{}
	if err := {{providerName}}.Project(r, &at); err != nil {
		return managed.ExternalObservation{}, errors.Wrap(err, errObserve)
	}
	cr.Status.AtProvider = at
{{/FETCH}}

	if meta.WasDeleted(cr) {
		cr.Status.SetConditions(xpv2.Deleting())
	} else {
		cr.Status.SetConditions(xpv2.Available())
	}

	return managed.ExternalObservation{
		ResourceExists:   true,
		ResourceUpToDate: upToDate(cr, &cr.Status.AtProvider),
	}, nil
}

func (c *external) Create(ctx context.Context, cr *{{crdVersion}}.{{kind}}) (managed.ExternalCreation, error) {
	cr.Status.SetConditions(xpv2.Creating())

{{#CREATE}}
	r, err := c.service.Rest.{{domainName}}{{apiVersionClass}}.{{nickname}}({{#vendorExtensions.x-cp-args}}{{{expr}}}, {{/vendorExtensions.x-cp-args}}createParams(cr))
	if err != nil {
		return managed.ExternalCreation{}, errors.Wrap(err, errCreate)
	}

	if r.{{vendorExtensions.x-resource-id}} == nil || *r.{{vendorExtensions.x-resource-id}} == "" {
		return managed.ExternalCreation{}, errors.New(errNoID)
	}

	meta.SetExternalName(cr, {{#vendorExtensions.x-resource-id-conversion-func}}{{providerName}}.{{vendorExtensions.x-resource-id-conversion-func}}{{/vendorExtensions.x-resource-id-conversion-func}}(*r.{{vendorExtensions.x-resource-id}}))

	at := {{crdVersion}}.{{kind}}Observation{}
	if err := {{providerName}}.Project(r, &at); err != nil {
		return managed.ExternalCreation{}, errors.Wrap(err, errObserve)
	}
	cr.Status.AtProvider = at
{{/CREATE}}

	return managed.ExternalCreation{}, nil
}

func (c *external) Update(ctx context.Context, cr *{{crdVersion}}.{{kind}}) (managed.ExternalUpdate, error) {
{{#UPDATE}}
	id := meta.GetExternalName(cr)
	if id == "" {
		return managed.ExternalUpdate{}, errors.New(errUpdate)
	}

	r, err := c.service.Rest.{{domainName}}{{apiVersionClass}}.{{nickname}}({{#vendorExtensions.x-cp-args}}{{{expr}}}, {{/vendorExtensions.x-cp-args}}updateParams(cr))
	if err != nil {
		return managed.ExternalUpdate{}, errors.Wrap(err, errUpdate)
	}

	at := {{crdVersion}}.{{kind}}Observation{}
	if err := {{providerName}}.Project(r, &at); err != nil {
		return managed.ExternalUpdate{}, errors.Wrap(err, errObserve)
	}
	cr.Status.AtProvider = at
{{/UPDATE}}
{{^UPDATE}}
	// The API describes no update for this resource. Every field is therefore
	// one that forces replacement, which the CRD says by marking them
	// required; there is nothing for an update to do.
	_ = cr
{{/UPDATE}}

	return managed.ExternalUpdate{}, nil
}

func (c *external) Delete(ctx context.Context, cr *{{crdVersion}}.{{kind}}) (managed.ExternalDelete, error) {
	cr.Status.SetConditions(xpv2.Deleting())

	id := meta.GetExternalName(cr)
	if id == "" {
		// Never created; nothing to destroy.
		return managed.ExternalDelete{}, nil
	}

{{#DELETE}}
	// A 404 means someone else already did it, which is success as far as
	// reconciliation is concerned.
	if err := c.service.Rest.{{domainName}}{{apiVersionClass}}.{{nickname}}({{#vendorExtensions.x-cp-args}}{{{expr}}}, {{/vendorExtensions.x-cp-args}}&twiliogo.{{nickname}}Params{}); err != nil && !{{providerName}}.IsNotFound(err) {
		return managed.ExternalDelete{}, errors.Wrap(err, errDelete)
	}
{{/DELETE}}

	return managed.ExternalDelete{}, nil
}

