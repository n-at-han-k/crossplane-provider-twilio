// {{kind}}Parameters are the configurable fields of a {{kind}}.
//
// These are the parameters of the create operation ({{#CREATE}}{{nickname}}{{/CREATE}}), plus any the
// update accepts and the create does not. The fields are spelled the way
// Twilio TAKES them -- PascalCase -- because that is the name the request
// carries; status.atProvider spells the same values the way Twilio ANSWERS
// them, in snake_case. Nothing translates between the two, so nothing can
// drift out of a translation layer.
type {{kind}}Parameters struct {
{{#specFields}}
	// {{goName}}{{#description}} {{{description}}}{{/description}}
{{#required}}
	// +kubebuilder:validation:Required
	{{goName}} {{goType}} `json:"{{jsonName}}"`
{{/required}}
{{^required}}
	// +optional
	{{goName}} {{goType}} `json:"{{jsonName}},omitempty"`
{{/required}}
{{/specFields}}
}

// {{kind}}Observation are the observable fields of a {{kind}}.
//
// These are the properties of what the read ({{#FETCH}}{{nickname}}{{/FETCH}}) answers -- what IS,
// including the fields a person also writes. The controller diffs the two.
type {{kind}}Observation struct {
{{#observation}}
	{{goName}} {{goType}} `json:"{{jsonName}},omitempty"`
{{/observation}}
}

